# Copy this file to .env and fill it in. Never put .env in git.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.5
DB_NAME=vetri_mart_db
DB_USER=vetrimart_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
SETTINGS_ENCRYPTION_KEY=generate-with-Fernet.generate_key

# ---- Online (Render + TiDB Cloud) only. render.yaml sets most of these; leave them out on your laptop. ----
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com
# DJANGO_HTTPS=True
# MEDIA_IN_DATABASE=True        # pictures are kept in the database, not on the disk
# BREVO_API_KEY=                # emails go through Brevo's web API instead of SMTP
# DB_DRIVER=pymysql             # use the pure-Python driver (automatic when mysqlclient is not installed)
# TiDB Cloud needs an encrypted connection. DB_PORT=4000, and DB_SSL_CA is the CA certificate file path:
#   on Render: /etc/ssl/certs/ca-certificates.crt   on your laptop: the isrgrootx1.pem file TiDB lets you download
# DB_SSL_CA=
